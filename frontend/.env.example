# KS Live Frontend — Environment Variables
# Copy this to .env.local for local development.
# On Netlify, add these in Site configuration → Environment variables instead.

# ── API URL ───────────────────────────────────────────────────────────────────
# Production (Netlify): LEAVE THIS UNSET. The app calls /api/* on the same
# origin and Netlify redirects those requests to the API Function. No CORS.
# Local development: defaults to http://<your-hostname>:3001 automatically.
# Only set this when the API is hosted on a different domain.
# VITE_API_URL=http://localhost:3001

# ── Real-time transport ───────────────────────────────────────────────────────
# Local development defaults to socket (Socket.IO on port 3001).
# Production defaults to polling because Netlify Functions cannot hold a
# persistent WebSocket. Set to "socket" only if you move the API to an
# always-on Node host (Render/VPS/Docker).
# VITE_REALTIME_MODE=socket

# Auction snapshot refresh interval for polling mode (milliseconds).
# 3000 is a good balance between responsiveness and function usage.
# VITE_AUCTION_POLL_MS=3000

# Scoreboard, public match page and OBS overlay refresh interval (milliseconds).
# Production defaults to 3000; local development defaults to 30000 because
# Socket.IO is available there.
# VITE_LIVE_POLL_MS=3000

# Firebase config is hardcoded in src/firebase.js
# No changes needed there for development
