# KS Live Backend — Environment Variables
# Copy this file to .env and fill in real values before starting.
#
# On Netlify these same variables are added in
# Site configuration → Environment variables. No .env file is uploaded.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ks-live
# Local:         mongodb://localhost:27017/ks-live
MONGODB_URI=mongodb://localhost:27017/ks-live

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (Frontend origin) ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# Auction add-on
# In production the auction module requires an active AuctionEntitlement or an
# admin account. Set this to false only while testing a fresh deployment.
AUCTION_REQUIRE_ENTITLEMENT=false

# ── Email (Brevo) — used for signup and password-reset OTP codes ───────────
# EMAIL_FROM must be a sender verified in Brevo (Senders & IP).
# While any value still says REPLACE_WITH_*, development prints OTPs to the console
# and production refuses to send.
#
# Fastest setup (HTTPS, no SMTP ports): create a v3 API key in
# Brevo → SMTP & API → API Keys (starts with xkeysib-) and set BREVO_API_KEY.
# When BREVO_API_KEY is set it takes priority and the SMTP_* settings are ignored.
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
#
# Alternative: SMTP relay. SMTP_USER is your Brevo login email, SMTP_PASS is the
# SMTP key from Brevo → SMTP & API → SMTP (starts with xsmtpsib-).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_BREVO_LOGIN_EMAIL
SMTP_PASS=REPLACE_WITH_BREVO_SMTP_KEY
EMAIL_FROM="KS Live <REPLACE_WITH_VERIFIED_SENDER>"

# ── OTP settings ───────────────────────────────────────────────────────────────
# Separate secret used to hash OTP codes (min 32 chars). Do not reuse JWT_SECRET.
OTP_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ── Stripe Payment Integration ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:5173
